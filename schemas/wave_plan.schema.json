{
  "type": "object",
  "additionalProperties": false,
  "required": ["wave_name", "enemies", "tactic", "event", "director_note"],
  "properties": {
    "wave_name": { "type": "string", "description": "Short dramatic name shown to players" },
    "enemies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "count", "lane"],
        "properties": {
          "type": { "type": "string", "enum": ["Grunt", "Archer", "Brute", "Healer"] },
          "count": { "type": "integer" },
          "lane": { "type": "string", "enum": ["north", "south", "east", "west"] }
        }
      }
    },
    "tactic": { "type": "string", "enum": ["focus_weak_lane", "split_push", "flank", "siege"] },
    "event": { "type": "string", "enum": ["none", "fog", "elite_spawn", "reinforcement_delay"] },
    "director_note": { "type": "string", "description": "One sentence explaining why this wave fits the team" }
  }
}
